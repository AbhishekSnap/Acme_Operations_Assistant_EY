{
  "realm": "acme",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "acme-app",
      "enabled": true,
      "publicClient": false,
      "secret": "acme-app-secret",
      "redirectUris": ["http://localhost:8000/*", "http://app:8000/*", "http://localhost:3000/*"],
      "webOrigins": ["http://localhost:8000", "http://app:8000", "http://localhost:3000"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "3600"
      }
    }
  ],
  "roles": {
    "realm": [
      {"name": "sales_user", "description": "Read-only access to customer and issue data"},
      {"name": "support_user", "description": "Read and update access for issues"},
      {"name": "admin", "description": "Full access including creating and updating next actions"}
    ]
  },
  "users": [
    {
      "username": "alice",
      "email": "alice@acme.internal",
      "enabled": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["sales_user"]
    },
    {
      "username": "bob",
      "email": "bob@acme.internal",
      "enabled": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["support_user"]
    },
    {
      "username": "carol",
      "email": "carol@acme.internal",
      "enabled": true,
      "credentials": [{"type": "password", "value": "password", "temporary": false}],
      "realmRoles": ["admin"]
    }
  ]
}
